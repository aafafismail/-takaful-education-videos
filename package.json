{
  "name": "takaful-education-videos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vertical animated infographic videos for takaful education (Remotion).",
  "scripts": {
    "studio": "remotion studio",
    "preview": "remotion studio",
    "render": "remotion render HealingFull end-project/healing-hari-ini-full.mp4",
    "render:chapters": "node scripts/render-chapters.mjs",
    "render:all": "npm run render && npm run render:chapters",
    "stills": "node scripts/render-stills.mjs",
    "subtitles": "node scripts/build-subtitles.mjs",
    "typecheck": "tsc --noEmit",
    "latte:sample": "remotion render LatteTakafulSample end-project/latte/latte-sample-10s.mp4",
    "latte:render": "remotion render LatteTakaful end-project/latte/latte-takaful-full.mp4",
    "latte:placeholders": "python3 scripts/make-latte-placeholders.py",
    "subtitles:latte": "node scripts/build-latte-subtitles.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.5",
    "@fontsource/poppins": "^5.2.5",
    "@remotion/cli": "4.0.527",
    "@remotion/shapes": "4.0.527",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@twemoji/svg": "^15.0.0",
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
